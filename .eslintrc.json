{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "ignorePatterns": ["tmp/**", "node_modules/**", ".next/**"],
  "overrides": [
    {
      "files": ["app/(current)/layout.tsx", "app/(current)/not-found.tsx", "app/(current)/awards/page.tsx", "app/(current)/experience/page.tsx", "app/(legacy)/layout.tsx"],
      "rules": { "@next/next/no-html-link-for-pages": "off" }
    },
    {
      "files": ["app/(legacy)/**", "components/*.tsx", "components/ui/**", "contexts/**", "hooks/**"],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "react/no-unescaped-entities": "off",
        "@next/next/no-img-element": "off"
      }
    }
  ]
}
